{
  "name": "yavka-desktop",
  "version": "1.0.0",
  "description": "Учёт явки студентов",
  "author": "Yavka",
  "main": "main.js",
  "dependencies": {
    "exceljs": "4.4.0"
  },
  "devDependencies": {
    "electron": "31.7.7",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "com.yavka.desktop",
    "productName": "Yavka",
    "files": [
      "main.js",
      "app/**"
    ],
    "win": {
      "target": "portable"
    },
    "portable": {
      "artifactName": "Yavka-${version}.exe"
    }
  }
}